{% macro section(title, id, class='', is_dark=false, is_rounded=false) %}
  <section id="{{ id }}"
           class="nes-container with-title {{ id }} {{ class }} {{ 'is-dark' if is_dark }} {{ 'is-rounded' if is_rounded }}"
           aria-labelledby="{{ id }}-title">
    <div class="title">
      <h2 id="{{ id }}-title"><a href="#{{ id }}">#</a>{{ title }}</h2></div>
    <div class="content">
      {{ caller() }}
    </div>
  </section>
{% endmacro %}

{% macro button(title, class="", type="is-primary") %}
  {# is-primary #}
  {# is-success #}
  {# is-warning #}
  {# is-error #}
  {# is-disabled #}
  <button class="nes-btn {{ type }} {{ class }}" type="button">
    <span>{{ title }}</span>
  </button>
{% endmacro %}

{% macro list(is_circle=true) %}
  <ul class="nes-list {{ 'is-circle' if is_circle else 'is-disc' }}">
    {{ caller() }}
  </ul>
{% endmacro %}


{% macro table() %}
  <div class="nes-table-responsive">
    <table class="nes-table is-bordered is-centered">
      <tbody>
      {{ caller() }}
      </tbody>
    </table>
  </div>
{% endmacro %}