{% macro section(title, id, class='', is_dark=false, is_border=true, color='default', is_partial=false) %}
  <section id="{{ id }}"
           class="{{ 'nes-container' if is_border }} with-title {{ id }} {{ class }}
               {{ 'is-dark' if color == 'dark' }}
               {{ 'is-green' if color == 'green' }}
               {{ 'is-red' if color == 'red' }}
               {{ 'is-yellow' if color == 'yellow' }}
               {{ 'is-regular' if color == 'default' }}
              {{ 'is-partial' if is_partial }}"
           aria-labelledby="{{ id }}-title">
    <div class="title">
      <h2 id="{{ id }}-title"><a href="#{{ id }}">#<span>{{ title }}</span></a></h2>
    </div>
    <div class="content">
      {{ caller() }}
    </div>
  </section>
{% endmacro %}

{% macro button(title, class="", type="is-primary") %}
  {# is-primary #}
  {# is-success #}
  {# is-warning #}
  {# is-error #}
  {# is-disabled #}
  <button class="pixel-button nes-pixel-borders is-regular {{ type }} {{ class }}" type="button">
    <span>{{ title }}</span>
  </button>
{% endmacro %}

{% macro list(is_circle=true) %}
  <ul class="nes-list {{ 'is-circle' if is_circle else 'is-disc' }}">
    {{ caller() }}
  </ul>
{% endmacro %}


{% macro table() %}
  <div class="nes-table-responsive">
    <table class="nes-table is-bordered is-centered">
      <tbody>
      {{ caller() }}
      </tbody>
    </table>
  </div>
{% endmacro %}