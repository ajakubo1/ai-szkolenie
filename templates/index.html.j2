{% extends "base.html.j2" %}

{% block content %}

  {% call forms.section(intro.title, "intro-card") %}
    <ol class="steps-list">
      {% for step in intro.steps %}
        <li>{{ step }}</li>
      {% endfor %}
    </ol>
  {% endcall %}

  {% call forms.section(safety.title, "safety-card") %}
    <p>{{ safety.text }}</p>
    {% call forms.list() %}
      {% for rule in safety.rules %}
        <li>{{ rule }}</li>
      {% endfor %}
    {% endcall %}
  {% endcall %}

  {% call forms.section(quick_prompts.title, "quick-card") %}
    {% for item in quick_prompts['items'] %}
      {{ forms.button(item, class="quick-copy") }}
    {% endfor %}
  {% endcall %}

  <nav class="section-nav" aria-label="Kategorie promptów">
    <h2>Kategorie</h2>

    <ul>
      {% for section in sections %}
        <li>
          <a href="#{{ section.id }}">{{ section.title }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>

  {% for section in sections %}
    {% include "partials/prompt_section.html.j2" %}
  {% endfor %}

{% endblock %}